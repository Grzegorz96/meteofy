{
  "name": "meteofy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -c auto -n shared,api,web \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "dev:shared": "npm run dev -w @meteofy/shared",
    "build": "npm run build -w @meteofy/shared && npm run build -w api && npm run build -w web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:web": "npm run lint -w web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.9.8"
  }
}

{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format.sh",
        "timeout": 20
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-git.sh",
        "matcher": "\\bgit(?:\\.exe)?\\s",
        "failClosed": true,
        "timeout": 10
      },
      {
        "command": ".cursor/hooks/block-env-read.sh",
        "matcher": "\\.e",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/block-env-file-read.sh",
        "matcher": "Read",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeTabFileRead": [
      {
        "command": ".cursor/hooks/block-env-file-read.sh",
        "matcher": "TabRead",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
